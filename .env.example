# .env.example – copy to .env and fill
# Telegram Premium Bot (Stars) via VLESS
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# e.g. TELEGRAM_BOT_TOKEN=8538622641:AAFpTLGdEO7WY-INiVSiIbIQfYqlDzPKHkQ
TELEGRAM_STARS_MONTHLY=150
TELEGRAM_STARS_YEARLY=1200
TELEGRAM_PROXY_SOCKS=socks5h://127.0.0.1:10808
TELEGRAM_PROXY_HTTP=http://127.0.0.1:10809
TELEGRAM_FORCE_PROXY=1
# Optional webhook secret
# TELEGRAM_WEBHOOK_SECRET=your_random_secret
